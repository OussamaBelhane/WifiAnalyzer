sequenceDiagram
    actor User
    participant App as Application
    participant Blocker as WiFiBlocker
    participant Network as Réseau

    %% Blocking
    User->>App: Bloquer appareil
    activate App
    
    App->>Blocker: block_device(IP)
    activate Blocker
    
    Note over Blocker: Démarrage thread<br/>ARP spoofing
    
    loop Continue jusqu'à déblocage
        Blocker->>Network: Envoyer paquets ARP falsifiés
    end
    
    Blocker-->>App: Appareil bloqué
    deactivate Blocker
    
    App-->>User: Notification
    deactivate App

    %% Unblocking
    User->>App: Débloquer appareil
    activate App
    
    App->>Blocker: unblock_device(IP)
    activate Blocker
    
    Note over Blocker: Arrêt thread<br/>ARP spoofing
    
    Blocker-->>App: Appareil débloqué
    deactivate Blocker
    
    App-->>User: Notification
    deactivate App

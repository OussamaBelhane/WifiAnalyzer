graph TB
    subgraph "Interface Utilisateur"
        GUI["NetworkAnalyzerApp<br/>(GUI CustomTkinter)"]
    end

    subgraph "Logique Métier"
        SCANNER["NetworkScanner<br/>(Scan réseau)"]
        BLOCKER["WiFiBlocker<br/>(Blocage ARP)"]
    end

    subgraph "Stockage"
        DB["DatabaseManager"]
        NEO4J["Neo4j (optionnel)"]
        JSON["Fichiers JSON"]
    end

    subgraph "Ressources Externes"
        NETWORK["Réseau Local"]
        OUI["Base OUI vendeurs"]
    end

    %% Connections
    GUI --> SCANNER
    GUI --> BLOCKER
    GUI --> DB
    
    SCANNER --> NETWORK
    SCANNER --> OUI
    
    BLOCKER --> NETWORK
    
    DB --> NEO4J
    DB --> JSON

    %% Styling
    classDef ui fill:#4A90E2,stroke:#2E4057,stroke-width:2px,color:#fff
    classDef logic fill:#16A085,stroke:#1E3A5F,stroke-width:2px,color:#fff
    classDef storage fill:#F39C12,stroke:#1A2332,stroke-width:2px,color:#fff
    classDef external fill:#95A5A6,stroke:#34495E,stroke-width:2px,color:#fff

    class GUI ui
    class SCANNER,BLOCKER logic
    class DB,NEO4J,JSON storage
    class NETWORK,OUI external
